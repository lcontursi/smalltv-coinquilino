diff --git a/src/channels/ch_pixel.cpp b/src/channels/ch_pixel.cpp
new file mode 100644
index 0000000..499540e
--- /dev/null
+++ b/src/channels/ch_pixel.cpp
@@ -0,0 +1,96 @@
+// Pixel — "il coinquilino": a screen the home server paints.
+//
+//   y=0..29    header: HH:MM (VT323-32) left, "SAB 24 OTT" (DMMono-11) right
+//   y=30..229  scene area 240x200, filled by POST /frame from the server
+//   y=230      indicator strip (main.cpp), untouched
+//
+// The device never holds an image: /frame streams raw RGB565 big-endian
+// bytes straight into the ST7789 window (see web.cpp). Each time the channel
+// becomes visible, draw() bumps an activation counter; the server polls
+// GET /pixel and repaints the full scene when that counter changes.
+
+#include "channel.h"
+#include "display.h"
+#include "theme.h"
+#include "config.h"
+#include <time.h>
+#include <string.h>
+
+static constexpr int HEADER_H = 30;
+static constexpr int SCENE_Y  = 30;
+static constexpr int SCENE_H  = 200;
+
+static uint32_t s_seq = 0;            // activation counter
+static uint32_t s_lastFrameMs = 0;    // millis() of the last completed frame
+static int      s_lastMin = -1;
+
+static const char* const kDays[]   = {"DOM","LUN","MAR","MER","GIO","VEN","SAB"};
+static const char* const kMonths[] = {"GEN","FEB","MAR","APR","MAG","GIU",
+                                      "LUG","AGO","SET","OTT","NOV","DIC"};
+
+// ── Exposed to web.cpp ──────────────────────────────────────────────────────
+// Testo d'attesa mostrato finche' non arriva la scena: lo imposta il NUC
+// (POST /pixel {"wait":"arriva Alessio..."}), cosi' segue il personaggio.
+static char s_wait[48] = "arriva...";
+const char* pixelWait()      { return s_wait; }
+void     pixelSetWait(const char* t) { strncpy(s_wait, t, sizeof(s_wait) - 1); s_wait[sizeof(s_wait) - 1] = 0; }
+
+uint32_t pixelSeq()          { return s_seq; }
+uint32_t pixelLastFrameMs()  { return s_lastFrameMs; }
+void     pixelFrameDone()    { s_lastFrameMs = millis(); }
+void     pixelSceneRect(int& x, int& y, int& w, int& h) { x = 0; y = SCENE_Y; w = SCREEN_W; h = SCENE_H; }
+
+static void paintHeader() {
+    time_t now = time(nullptr);
+    struct tm t;
+    localtime_r(&now, &t);
+
+    char hm[6];
+    snprintf(hm, sizeof(hm), "%02d:%02d", t.tm_hour, t.tm_min);
+    char date[16];
+    snprintf(date, sizeof(date), "%s %d %s", kDays[t.tm_wday], t.tm_mday, kMonths[t.tm_mon]);
+
+    // Clip to the header so the 32-px font can never touch the scene.
+    tft.setViewport(0, 0, SCREEN_W, HEADER_H);
+    tft.fillRect(0, 0, SCREEN_W, HEADER_H, Theme::BG);
+
+    Display::useFont("VT323-32");
+    tft.setTextDatum(ML_DATUM);
+    tft.setTextColor(Theme::INK, Theme::BG);
+    tft.drawString(hm, 10, HEADER_H / 2);
+
+    Display::useFont("DMMono-11");
+    tft.setTextDatum(MR_DATUM);
+    tft.setTextColor(Theme::MUTED, Theme::BG);
+    tft.drawString(date, SCREEN_W - 10, HEADER_H / 2);
+    tft.resetViewport();
+
+    s_lastMin = t.tm_min;
+}
+
+bool chPixelEnabled(const ChannelCtx& ctx) {
+    return ctx.settings && ctx.settings->showPixel
+        && time(nullptr) > 1000000000L;
+}
+
+void chPixelDraw(const ChannelCtx& ctx) {
+    (void)ctx;
+    Display::clear();
+    paintHeader();
+
+    // Placeholder until the server sends the scene (usually < 2 s).
+    Display::useFont("PixelifySans-14");
+    tft.setTextDatum(MC_DATUM);
+    tft.setTextColor(Theme::MUTED, Theme::BG);
+    tft.drawString(s_wait, SCREEN_W / 2, SCENE_Y + SCENE_H / 2);
+
+    s_seq++;
+}
+
+void chPixelTick(const ChannelCtx& ctx) {
+    (void)ctx;
+    time_t now = time(nullptr);
+    struct tm t;
+    localtime_r(&now, &t);
+    if (t.tm_min != s_lastMin) paintHeader();
+}
