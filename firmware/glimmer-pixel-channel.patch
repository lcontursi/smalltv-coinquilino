     server.send(200, "application/json", out);
 }
 
+// ── Pixel channel: stream frames straight to the panel ─────────────────────
+//   GET  /pixel  → {"active":bool,"seq":N,"x":0,"y":30,"w":240,"h":200,"age_ms":N,"wait":"..."}
+//   POST /pixel  {"wait":"arriva Alessio..."} — testo d'attesa
+//   POST /frame?x=&y=&w=&h=  multipart field "frame" = w*h*2 bytes RGB565 big-endian.
+//   Coordinates are relative to the scene area; the window is clipped to it.
+//   Only painted while the Pixel channel is on screen (else 409, nothing drawn).
+extern uint32_t pixelSeq();
+extern uint32_t pixelLastFrameMs();
+extern void     pixelFrameDone();
+extern void     pixelSceneRect(int& x, int& y, int& w, int& h);
+extern const char* pixelWait();
+extern void     pixelSetWait(const char* t);
+
+static bool     s_frameOk    = false;   // this upload is being painted
+static uint32_t s_frameLeft  = 0;       // bytes still accepted for the window
+static int      s_frameCarry = -1;      // odd byte held over between chunks
+static bool     s_frameSwap  = false;
+static const char* s_frameErr = nullptr;
+static bool     s_frameSeen  = false;   // a "frame" part arrived in this request
+
+static bool pixelOnScreen() {
+    return !strcmp(mainActiveChannelName(), "Pixel");
+}
+
+static void handlePixelState() {
+    int x, y, w, h; pixelSceneRect(x, y, w, h);
+    uint32_t last = pixelLastFrameMs();
+    JsonDocument d;
+    d["active"] = pixelOnScreen();
+    d["seq"]    = pixelSeq();
+    d["x"] = x; d["y"] = y; d["w"] = w; d["h"] = h;
+    d["age_ms"] = last ? (long)(millis() - last) : -1L;
+    d["wait"]   = pixelWait();
+    String out; serializeJson(d, out);
+    server.send(200, "application/json", out);
+}
+
+// POST /pixel {"wait":"arriva Alessio..."} — testo d'attesa del canale (max 47 caratteri ASCII)
+static void handlePixelSet() {
+    if (!checkAuth()) { server.send(401, "application/json", "{\"error\":\"unauthorized\"}"); return; }
+    JsonDocument d;
+    if (deserializeJson(d, server.arg("plain"))) {
+        server.send(400, "application/json", "{\"error\":\"bad json\"}");
+        return;
+    }
+    if (d["wait"].is<const char*>()) pixelSetWait(d["wait"].as<const char*>());
+    handlePixelState();
+}
+
+static void frameUpload() {
+    HTTPUpload& up = server.upload();
+    if (up.status == UPLOAD_FILE_START) {
+        s_frameOk = false; s_frameCarry = -1; s_frameErr = nullptr; s_frameSeen = true;
+        if (!checkAuth())        { s_frameErr = "unauthorized"; return; }
+        if (!pixelOnScreen())    { s_frameErr = "pixel channel not on screen"; return; }
+        int sx, sy, sw, sh; pixelSceneRect(sx, sy, sw, sh);
+        int x = server.arg("x").toInt(), y = server.arg("y").toInt();
+        int w = server.hasArg("w") ? server.arg("w").toInt() : sw;
+        int h = server.hasArg("h") ? server.arg("h").toInt() : sh;
+        // compare without adding: huge w/h must not overflow past the check
+        if (x < 0 || y < 0 || w <= 0 || h <= 0 || w > sw || h > sh || x > sw - w || y > sh - h) {
+            s_frameErr = "window outside scene"; return;
+        }
+        s_frameLeft = (uint32_t)w * h * 2;
+        s_frameSwap = tft.getSwapBytes();
+        tft.setSwapBytes(false);             // bytes go to the panel as sent
+        tft.setAddrWindow(sx + x, sy + y, w, h);
+        s_frameOk = true;
+    } else if (up.status == UPLOAD_FILE_WRITE) {
+        if (!s_frameOk || s_frameLeft == 0) return;
+        uint8_t* p = up.buf;
+        size_t   n = up.currentSize;
+        if (s_frameCarry >= 0 && n) {        // finish a pixel split across chunks
+            uint8_t px[2] = { (uint8_t)s_frameCarry, p[0] };
+            tft.pushColors(px, 2);
+            s_frameLeft -= 2; s_frameCarry = -1; p++; n--;
+        }
+        if (n > s_frameLeft) n = s_frameLeft;
+        size_t even = n & ~(size_t)1;
+        if (even) { tft.pushColors(p, even); s_frameLeft -= even; }
+        if (n & 1) s_frameCarry = p[n - 1];
+    } else if (up.status == UPLOAD_FILE_END || up.status == UPLOAD_FILE_ABORTED) {
+        if (s_frameOk) {
+            tft.setSwapBytes(s_frameSwap);
+            if (up.status == UPLOAD_FILE_END && s_frameLeft == 0) pixelFrameDone();
+            else if (!s_frameErr) s_frameErr = up.status == UPLOAD_FILE_END ? "short frame" : "aborted";
+        }
+        s_frameOk = false;
+    }
+}
+
+static void frameDone() {
+    if (!s_frameSeen) s_frameErr = "missing frame";
+    s_frameSeen = false;
+    if (s_frameErr) {
+        int code = !strcmp(s_frameErr, "unauthorized") ? 401
+                 : !strcmp(s_frameErr, "pixel channel not on screen") ? 409 : 400;
+        server.send(code, "application/json", String("{\"error\":\"") + s_frameErr + "\"}");
+        return;
+    }
+    char out[64];
+    snprintf(out, sizeof(out), "{\"ok\":true,\"seq\":%lu}", (unsigned long)pixelSeq());
+    server.send(200, "application/json", out);
+}
+
